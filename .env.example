# Used by prisma.config.ts (CLI) and src/prisma/prisma.service.ts (runtime).
# PostgreSQL connection string for Prisma
# https://www.prisma.io/docs/orm/reference/connection-urls
# For TLS hosts, prefer `sslmode=verify-full` (avoids pg driver sslmode deprecation warnings).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/litebank?schema=public"

# RS256 PEMs for JWT (`JwtModule`) and refresh-token fingerprint (`src/libs/generateHmac.ts`).
# Generate: `openssl genrsa -out jwt-rs256-private.pem 2048` then
# `openssl rsa -in jwt-rs256-private.pem -pubout -out jwt-rs256-public.pem`
# Paste each file’s contents here (multiline quoted string is fine in dotenv).
JWT_RS256_PRIVATE_KEY=""
JWT_RS256_PUBLIC_KEY=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Auth identity (credentials). Table `users` avoids the PostgreSQL reserved name `user`.
model User {
  id           Int      @id @default(autoincrement())
  /// Opaque identifier for APIs/JWT `sub` (not the internal PK).
  publicId     String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  customers Customer[]
  sessions  Session[]

  @@map("users")
}

/// Customer profile linked to a user (one per user).
model Customer {
  id        Int    @id @default(autoincrement())
  email     String
  firstName String @map("first_name")
  lastName  String @map("last_name")
  userId    Int    @unique @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customers")
}

model Session {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  deviceLabel String?   @map("device_label")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id                 Int       @id @default(autoincrement())
  sessionId          Int       @map("session_id")
  tokenHash          String    @map("token_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  rotatedFromTokenId Int?      @map("rotated_from_token_id")
  rotatedAt          DateTime? @map("rotated_at")

  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rotatedFrom RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromTokenId], references: [id], onDelete: SetNull)
  rotatedInto RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([rotatedFromTokenId])
  @@map("refresh_tokens")
}

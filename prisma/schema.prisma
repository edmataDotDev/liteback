generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Auth identity (credentials). Table `users` avoids the PostgreSQL reserved name `user`.
model User {
  id           Int      @id @default(autoincrement())
  /// Opaque identifier for APIs/JWT `sub` (not the internal PK).
  publicId     String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  customers Customer[]
  sessions  Session[]

  @@map("users")
}

/// Customer profile linked to a user (one per user).
model Customer {
  id        Int    @id @default(autoincrement())
  email     String
  firstName String @map("first_name")
  lastName  String @map("last_name")
  userId    Int    @unique @map("user_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     Account[]
  transactions Transaction[]

  @@map("customers")
}

model Account {
  id           Int      @id @default(autoincrement())
  publicId     String   @unique @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 12)")) @map("public_id")
  customerId   Int      @map("customer_id")
  /// Stored in minor units (e.g. 100 = 1.00). Non-negative by DB check constraint.
  balanceMinor Int      @map("balance_minor")
  currency     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([customerId])
  @@map("accounts")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Transaction {
  id         Int             @id @default(autoincrement())
  customerId Int             @map("customer_id")
  accountId  Int             @map("account_id")
  type       TransactionType
  /// Stored in minor units (e.g. 100 = 1.00). Must be positive.
  amountMinor Int            @map("amount_minor")
  createdAt  DateTime        @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([accountId])
  @@map("transactions")
}

model IdempotencyKey {
  idempotencyKey String   @id @map("idempotency_key") @db.Uuid
  requestHash    String   @map("request_hash")
  status         String
  responseCode   Int?     @map("response_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model Session {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  deviceLabel String?   @map("device_label")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id                 Int       @id @default(autoincrement())
  sessionId          Int       @map("session_id")
  tokenHash          String    @map("token_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  rotatedFromTokenId Int?      @map("rotated_from_token_id")
  rotatedAt          DateTime? @map("rotated_at")

  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rotatedFrom RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromTokenId], references: [id], onDelete: SetNull)
  rotatedInto RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([rotatedFromTokenId])
  @@map("refresh_tokens")
}
